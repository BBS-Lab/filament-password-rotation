{
    "name": "bbs-lab/filament-password-rotation",
    "description": "Force Filament users (or any authenticatable) to rotate their password every N days, with a native forced-change page, reuse prevention and expiry warnings.",
    "keywords": [
        "BBS",
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "password",
        "password-rotation",
        "password-expiration",
        "security"
    ],
    "homepage": "https://github.com/BBS-Lab/filament-password-rotation",
    "support": {
        "issues": "https://github.com/BBS-Lab/filament-password-rotation/issues",
        "source": "https://github.com/BBS-Lab/filament-password-rotation"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "BBS",
            "email": "paris@big-boss-studio.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "pestphp/pest-plugin-livewire": "^3.0 || ^4.0",
        "pestphp/pest-plugin-mutate": "^3.0 || ^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "BBSLab\\FilamentPasswordRotation\\": "src/",
            "BBSLab\\FilamentPasswordRotation\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BBSLab\\FilamentPasswordRotation\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BBSLab\\FilamentPasswordRotation\\FilamentPasswordRotationServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "clean-testbench-env": "@php -r \"@unlink('vendor/orchestra/testbench-core/laravel/.env');\"",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@clean-testbench-env",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage --min=100",
        "test-mutation": "XDEBUG_MODE=coverage vendor/bin/pest --mutate --everything --covered-only --min=80",
        "format": "vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
