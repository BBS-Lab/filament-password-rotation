APP_NAME="BBS Lab - Filament Password Rotation"
APP_ENV=local
APP_KEY=AckfSECXIvnK5r28GVIWUAxmbBSjTsmF
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Password rotation ────────────────────────────────────────────────────────
# Package config (config/filament-password-rotation.php) reads these. All are
# optional and shown at their package defaults; tweak while serving the panel —
# e.g. drop DAYS to 0 to force every account expired, or raise WARN_DAYS so the
# "expiring soon" callout shows for the seeded user.
PASSWORD_ROTATION_ENABLED=true
PASSWORD_ROTATION_DAYS=90
PASSWORD_ROTATION_WARN_DAYS=7
PASSWORD_ROTATION_HISTORY_COUNT=3
PASSWORD_ROTATION_FORCE_FIRST_LOGIN=true
PASSWORD_ROTATION_REQUIRE_CURRENT=true
# PASSWORD_ROTATION_COLUMN=password_changed_at
# PASSWORD_ROTATION_MORPH_KEY_TYPE=   # empty=auto (bigint) | uuid | ulid
# PASSWORD_ROTATION_SLUG=password/rotate
